# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# domain_assistant.py uses Gemini (GeminiGenerator) by default.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
